#bsod_body {
    align: center middle;
    content-align: center middle;
}

#bsod_grid {
    align: center middle;
    content-align: center middle;
    border: solid red;
    width: 50%;
    height: 50%;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

Button {
    width: 100%;
}